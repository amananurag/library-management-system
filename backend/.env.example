# server
PORT=4000

# database
DB_PATH=./data/library.sqlite

# client credentials (the /api/auth/client-token endpoint validates against these)
CLIENT_ID=demo-client
CLIENT_SECRET=demo-client-secret-change-me

# token TTLs in milliseconds
CLIENT_TOKEN_TTL_MS=3600000
USER_TOKEN_TTL_MS=86400000

# bcrypt
BCRYPT_ROUNDS=10

# cors origin (the React dev server)
CORS_ORIGIN=http://localhost:5173
