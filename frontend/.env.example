# Frontend client credentials (POC: in production these stay on the server only).
# These are sent to POST /api/auth/client-token to bootstrap the client token.
VITE_CLIENT_ID=demo-client
VITE_CLIENT_SECRET=demo-client-secret-change-me

# API origin override (optional). Default is "" so the Vite proxy picks it up.
# VITE_API_BASE=http://localhost:4000
